# Copy to .env.local for local development (git-ignored).
# Both values come from Supabase: Project Settings -> API.
# The anon key is PUBLIC by design (row-level security is the access control).
# NEVER put a service_role key in any VITE_* variable: it would ship to every visitor.
VITE_SUPABASE_URL=https://REPLACE-ME.supabase.co
VITE_SUPABASE_ANON_KEY=REPLACE-ME

# Optional. Absolute site URL, used for canonical / Open Graph / sitemap.
# On Vercel it is picked up automatically from VERCEL_PROJECT_PRODUCTION_URL.
# VITE_SITE_URL=https://your-domain.example
